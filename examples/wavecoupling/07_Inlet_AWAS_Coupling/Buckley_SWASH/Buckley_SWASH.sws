$*************HEADING***********************************
$
PROJ 'Buckley_SWASH' '01' 
$
$***********MODEL INPUT*********************************
$
MODE NONST ONED
SET LEVEL   0.000
SET depmin 0.0005
$
$ Grid running from x=7.16 m to x=40.06 m with 0.05 m resolution
$
CGRID 7.16 0. 0. 32.9 0 658 0
VERT 10
$
$ Bottom grid file from x=0 m to x=40.08 m
$
INPGRID BOTTOM 0. 0. 0. 2004 0 0.02 0
READINP BOTTOM -1 'Buckley_SWASH_739.6mm.bot' 1 0 FREE
$
SET BACKVISC 1.E-5
VISC V KEPS
$
FRIC LOGLAW ROUGH 4.E-4 
$
INIT zero
$
include 'four_incoming.fou'
$
NONHYDROSTATIC STANDARD PREC ILU
$
DISCRET UPW UMOM MOMentum HOR KOREN
DISCRET UPW UMOM MOMentum VERT FIRST
DISCRET UPW WMOM HOR KOREN
DISCRET UPW WMOM VERT FIRST
DISCRET CORRDEP KOREN
$
TIMEI METH EXPL 0.1 0.5
$
$************ OUTPUT REQUESTS *************************
$
POINTS 'GAUGE' FILE 'Buckley_SWASH.loc'
TABLE  'GAUGE' NOHEAD 'Buckley_SWASH.tbl' TSEC WATL    OUTPUT 000000.000 0.05 SEC
TABLE  'GAUGE' NOHEAD 'Buckley_SWASH.vel' TSEC VELK VZ OUTPUT 000000.000 0.05 SEC
POINTS 'GAUGE2' FILE 'Buckley_OBC_SWASH.loc'
TABLE  'GAUGE2' NOHEAD 'Buckley_OBC_SWASH.tbl' TSEC WATL    OUTPUT 000000.000 0.05 SEC
TABLE  'GAUGE2' NOHEAD 'Buckley_OBC_SWASH.vel' VKSIK        OUTPUT 000000.000 0.05 SEC
POINTS 'GAUGE3' FILE 'Buckley_OBC_SWASH.awa'
TABLE  'GAUGE3' NOHEAD 'Buckley_OBC_SWASH.tbla' TSEC WATL    OUTPUT 000000.000 0.05 SEC
POINTS 'GAUGE4' FILE 'Buckley_SWASH_extra.loc'
TABLE  'GAUGE4' NOHEAD 'Buckley_SWASH_extra.tbl' TSEC WATL    OUTPUT 000000.000 0.05 SEC
TABLE  'GAUGE4' NOHEAD 'Buckley_SWASH_extra.vel' TSEC VELK VZ OUTPUT 000000.000 0.05 SEC

POINTS 'GAUGE5' FILE 'Buckley_OBC_SWASH_2.loc'
TABLE  'GAUGE5' NOHEAD 'Buckley_OBC_SWASH_2.tbl' TSEC WATL    OUTPUT 000000.000 0.05 SEC
TABLE  'GAUGE5' NOHEAD 'Buckley_OBC_SWASH_2.vel' VKSIK        OUTPUT 000000.000 0.05 SEC
POINTS 'GAUGE6' FILE 'Buckley_OBC_SWASH_2.awa'
TABLE  'GAUGE6' NOHEAD 'Buckley_OBC_SWASH_2.tbla' TSEC WATL    OUTPUT 000000.000 0.05 SEC
											
BLOCK  'COMPGRID' NOHEAD 'Buckley_SWASH.mat' HSIG HRMS SETUP
QUANT HSIG  dur 15 min
QUANT HRMS  dur 15 min
QUANT SETUP dur 15 min
$
GROUP 'ALL' 1 658 1 1
TABLE 'ALL' NOHEAD 'btm.tbl' XP BOTLEV
TABLE 'ALL' NOHEAD 'HsSetup.tbl' XP HS SETUP
TABLE 'ALL' NOHEAD 'WL.csv' WATL OUTPUT 000000.000 0.05 SEC
TABLE 'ALL' NOHEAD 'XP.csv' XP
TABLE 'ALL' NOHEAD 'BOT.csv' BOTLEV
$
GROUP 'TIME' 1 1 1 1
TABLE 'TIME' NOHEAD 'time.csv' TSEC OUTPUT 000000.000 0.05 SEC
$
TEST 1 0
COMPUTE 001000.000  0.005 SEC 001500.000
STOP
$